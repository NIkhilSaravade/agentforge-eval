{
  "name": "agentforge-eval-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Results site for AgentForge Eval. Renders only from src/data.json, which scripts/build-data.mjs generates from the repo's real result files.",
  "scripts": {
    "data": "node scripts/build-data.mjs",
    "dev": "vite",
    "build": "npm run data && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "node scripts/lint-tells.mjs",
    "shots": "node scripts/shots.mjs",
    "check": "npm run data && npm test && npm run lint && tsc -b"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "motion": "^13.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
